# Copy to .env and fill in. Never commit .env.

# Core API (auth + delivery). Override only to point at another environment.
API_BASE=https://core.test.api.noor.uz
# Employees live on the eats host.
EMPLOYEES_API_URL=https://eats.test.api.noor.uz/api/v1
# Required header on authenticated calls: web | ios | android
X_PLATFORM=web

# Merchant login used by the suite
MERCHANT_PHONE=+998XXXXXXXXX
MERCHANT_PASSWORD=

# Employee lifecycle (add -> activate via OTP -> login -> edit -> remove). The test env
# fixes a hardcoded OTP for the virtual +99800XXXXXXX numbers; set it to run the lifecycle.
# The test generates a fresh virtual number each run and cleans the employee up.
EMPLOYEE_TEST_OTP=

# Forgot-password flow — skipped unless RESET_PHONE and RESET_OTP are both set.
# A +99800XXXXXXX test number uses the same hardcoded OTP as EMPLOYEE_TEST_OTP.
RESET_PHONE=
RESET_OTP=
RESET_NEW_PASSWORD=Noor-Reset-1!
