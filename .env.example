# Copy to .env and fill in. Never commit .env.

# Core API (auth + delivery). Override only to point at another environment.
API_BASE=https://core.test.api.noor.uz
# Employees live on the eats host.
EMPLOYEES_API_URL=https://eats.test.api.noor.uz/api/v1
# Required header on authenticated calls: web | ios | android
X_PLATFORM=web

# Merchant login used by the suite
MERCHANT_PHONE=+998XXXXXXXXX
MERCHANT_PASSWORD=

# Hardcoded test-env OTP for the virtual +99800XXXXXXX numbers. Enables:
#  - the employee lifecycle (add -> activate -> login -> remove)
#  - the forgot-password reset flow (provisions a user, resets, verifies)
# Both self-provision a fresh virtual number each run and clean up. Leave empty to skip them.
EMPLOYEE_TEST_OTP=
