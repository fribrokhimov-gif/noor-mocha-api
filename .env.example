# Copy to .env and fill in. Never commit .env.

# Core API (auth + delivery). Override only to point at another environment.
API_BASE=https://core.test.api.noor.uz
# Employees live on the eats host.
EMPLOYEES_API_URL=https://eats.test.api.noor.uz/api/v1
# Required header on authenticated calls: web | ios | android
X_PLATFORM=web

# Merchant login used by the suite
MERCHANT_PHONE=+998XXXXXXXXX
MERCHANT_PASSWORD=

# Employee lifecycle (add -> edit -> remove) — skipped unless set. Adding an employee sends
# an SMS with a password, so use a number you control.
EMPLOYEE_TEST_PHONE=

# Forgot-password flow — skipped unless RESET_PHONE and RESET_OTP are both set. Use a
# dedicated test number whose OTP the backend fixes.
RESET_PHONE=
RESET_OTP=
RESET_NEW_PASSWORD=Noor-Reset-1!
