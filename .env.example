# Copy to .env and fill in. Never commit .env.

# Core API (auth + delivery). Override only to point at another environment.
API_BASE=https://core.test.api.noor.uz
# Required header on authenticated calls: web | ios | android
X_PLATFORM=web

# Merchant login used by the auth suite
MERCHANT_PHONE=+998XXXXXXXXX
MERCHANT_PASSWORD=

# Forgot-password flow (test/auth-forgot-password.spec.js) — skipped unless RESET_PHONE
# and RESET_OTP are both set. Use a dedicated test number whose OTP the backend fixes.
RESET_PHONE=
RESET_OTP=
RESET_NEW_PASSWORD=Noor-Reset-1!
