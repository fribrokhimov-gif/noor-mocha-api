{
  "name": "noor-mocha-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "mocha --reporter mochawesome --reporter-options reportDir=reports,reportFilename=report,quiet=true",
    "test:smoke": "mocha --grep @smoke --reporter mochawesome --reporter-options reportDir=reports,reportFilename=report,quiet=true",
    "test:ci": "mocha --reporter mocha-multi-reporters --reporter-options configFile=reporter-config.json"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "mocha": "^11.8.0",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.2",
    "mochawesome": "^8.1.1",
    "supertest": "^7.3.2"
  }
}
